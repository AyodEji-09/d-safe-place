# Resend API Key (get from https://resend.com/api-keys)
RESEND_API_KEY=re_your_api_key_here

# Resend Audience ID for Newsletter Subscribers (get from https://resend.com/audiences)
RESEND_AUDIENCE_ID=your_audience_id_here

# Where contact inquiries and appointment booking notifications are sent
CONTACT_NOTIFICATION_EMAIL=intake@dsafeplace.org

# Sender address (use onboarding@resend.dev during testing, or your verified domain e.g. contact@dsafeplace.org)
FROM_EMAIL="D Safe Place <onboarding@resend.dev>"
